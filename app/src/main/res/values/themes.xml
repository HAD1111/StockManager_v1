<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base Application Theme -->
    <style name="Theme.MyStock" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- ===== COLOR PALETTE ===== -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorOnSecondary">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/surface</item>

        <!-- ===== WINDOW & BACKGROUNDS ===== -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>

        <!-- ===== SYSTEM STATUS BAR & NAVIGATION BAR (LIGHT MODE) ===== -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- ===== TYPOGRAPHY & FONT DEFAULTS ===== -->
        <item name="fontFamily">@font/dm_sans</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>

        <!-- ===== DEFAULT COMPONENT STYLES ===== -->
        <item name="materialCardViewStyle">@style/Widget.StockManager.Card</item>
        <item name="materialButtonStyle">@style/Widget.StockManager.Button</item>
        <item name="borderlessButtonStyle">@style/Widget.StockManager.Button.Text</item>
        <item name="textInputStyle">@style/Widget.StockManager.TextInputLayout</item>
        <item name="floatingActionButtonStyle">@style/Widget.StockManager.Fab</item>
        <item name="bottomNavigationStyle">@style/Widget.StockManager.BottomNavigationView</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.StockManager.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.StockManager.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.StockManager.BottomSheetDialog</item>

    </style>

    <!-- ===== CARDS & CONTAINERS ===== -->
    <style name="Widget.StockManager.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">@dimen/stroke_subtle</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <!-- Backward compatibility for existing CardStyle references -->
    <style name="CardStyle" parent="Widget.StockManager.Card" />

    <!-- ===== BUTTONS ===== -->
    <style name="Widget.StockManager.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/surface</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/dm_sans</item>
    </style>

    <style name="Widget.StockManager.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">@dimen/stroke_subtle</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/dm_sans</item>
    </style>

    <style name="Widget.StockManager.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/dm_sans</item>
    </style>

    <style name="Widget.StockManager.Button.Teal" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/surface</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/dm_sans</item>
    </style>

    <!-- ===== TEXT INPUTS ===== -->
    <style name="Widget.StockManager.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_box_stroke_selector</item>
        <item name="boxStrokeWidth">@dimen/stroke_subtle</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_focus</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="hintTextColor">@color/accent</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="errorTextColor">@color/danger</item>
        <item name="boxStrokeErrorColor">@color/danger</item>
    </style>

    <!-- Backward compatibility for existing EditText search style references -->
    <style name="MyTextInputStyle" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:fontFamily">@font/dm_sans</item>
    </style>

    <!-- ===== BOTTOM NAVIGATION ===== -->
    <style name="Widget.StockManager.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="elevation">@dimen/elevation_none</item>
        <item name="itemIconTint">@color/bottom_nav_colors</item>
        <item name="itemTextColor">@color/bottom_nav_colors</item>
        <item name="itemRippleColor">@color/accent_light</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.StockManager.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.StockManager.BottomNav.Inactive</item>
    </style>

    <!-- ===== FLOATING ACTION BUTTON ===== -->
    <style name="Widget.StockManager.Fab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/surface</item>
        <item name="elevation">@dimen/elevation_fab</item>
        <item name="hoveredFocusedTranslationZ">6dp</item>
        <item name="pressedTranslationZ">6dp</item>
    </style>

    <!-- ===== DIALOGS & BOTTOM SHEETS ===== -->
    <style name="ThemeOverlay.StockManager.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.StockManager.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.StockManager.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.StockManager.Button.Text</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.StockManager.Dialog</item>
    </style>

    <style name="ShapeAppearance.StockManager.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <style name="ThemeOverlay.StockManager.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="bottomSheetStyle">@style/Widget.StockManager.BottomSheet</item>
    </style>

    <style name="Widget.StockManager.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.StockManager.BottomSheet</item>
        <item name="backgroundTint">@color/surface</item>
    </style>

    <style name="ShapeAppearance.StockManager.BottomSheet" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSizeTopLeft">@dimen/radius_lg</item>
        <item name="cornerSizeTopRight">@dimen/radius_lg</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ===== BADGES ===== -->
    <style name="Widget.StockManager.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:paddingHorizontal">@dimen/badge_padding_horizontal</item>
        <item name="android:paddingVertical">@dimen/badge_padding_vertical</item>
        <item name="android:fontFamily">@font/dm_sans</item>
    </style>

    <style name="Widget.StockManager.Badge.Success" parent="Widget.StockManager.Badge">
        <item name="android:background">@drawable/bg_badge_success</item>
        <item name="android:textColor">@color/success</item>
    </style>

    <style name="Widget.StockManager.Badge.Danger" parent="Widget.StockManager.Badge">
        <item name="android:background">@drawable/bg_badge_loss</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="Widget.StockManager.Badge.Neutral" parent="Widget.StockManager.Badge">
        <item name="android:background">@drawable/bg_badge_neutral</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.StockManager.Badge.Primary" parent="Widget.StockManager.Badge">
        <item name="android:background">@drawable/bg_badge_primary</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- ===== TYPOGRAPHY HIERARCHY ===== -->
    <style name="TextAppearance.StockManager.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>

    <style name="TextAppearance.StockManager.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>

    <style name="TextAppearance.StockManager.HeadingLarge" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_heading_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>

    <style name="TextAppearance.StockManager.HeadingMedium" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_heading_md</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>

    <style name="TextAppearance.StockManager.HeadingSmall" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">@dimen/text_heading_sm</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>

    <style name="TextAppearance.StockManager.BodyLarge" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>

    <style name="TextAppearance.StockManager.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>

    <style name="TextAppearance.StockManager.BodySmall" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>

    <style name="TextAppearance.StockManager.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>

    <style name="TextAppearance.StockManager.FinancialValue" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_heading_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>

    <style name="TextAppearance.StockManager.FinancialValue.Large" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>

    <style name="TextAppearance.StockManager.BottomNav.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>

    <style name="TextAppearance.StockManager.BottomNav.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>

</resources>
