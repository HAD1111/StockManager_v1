<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── 1. HEADER SECTION ───────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good morning"
                    android:textSize="13sp"
                    android:fontFamily="@font/dm_sans"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvBusinessName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Business"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/dm_sans"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvCurrentDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp"
                    android:fontFamily="@font/dm_sans"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <!-- Store avatar badge -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_avatar">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_home"
                    app:tint="@color/primary" />
            </FrameLayout>

        </LinearLayout>

        <!-- ── 2. QUICK ACTIONS ────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <!-- Add Sale (Primary action) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickAddSale"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.2"
                android:layout_marginEnd="6dp"
                android:text="New Sale"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/dm_sans"
                android:textColor="@color/surface"
                app:backgroundTint="@color/primary"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/surface"
                app:iconSize="16dp" />

            <!-- Add Product -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickAddProduct"
                style="@style/Widget.StockManager.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Stock"
                android:textSize="12sp"
                android:fontFamily="@font/dm_sans"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/border"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_nav_stock"
                app:iconTint="@color/primary"
                app:iconSize="15dp" />

            <!-- Add Expense -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickAddExpense"
                style="@style/Widget.StockManager.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Expense"
                android:textSize="12sp"
                android:fontFamily="@font/dm_sans"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/border"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/primary"
                app:iconSize="15dp" />

        </LinearLayout>

        <!-- ── 3. FINANCIAL OVERVIEW ───────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FINANCIAL OVERVIEW"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:fontFamily="@font/dm_sans"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <!-- Row 1: Revenue & Recognized Profit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <!-- Revenue Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRevenue"
                style="@style/Widget.StockManager.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="REVENUE"
                            android:textSize="10sp"
                            android:letterSpacing="0.08"
                            android:fontFamily="@font/dm_sans"
                            android:textColor="@color/text_secondary" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_revenue"
                            app:tint="@color/primary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/dm_sans"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Recognized sales"
                        android:textSize="11sp"
                        android:fontFamily="@font/dm_sans"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Recognized Profit Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfit"
                style="@style/Widget.StockManager.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PROFIT"
                            android:textSize="10sp"
                            android:letterSpacing="0.08"
                            android:fontFamily="@font/dm_sans"
                            android:textColor="@color/text_secondary" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_profit"
                            app:tint="@color/accent" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProfit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/dm_sans"
                        android:textColor="@color/accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="After costs covered"
                        android:textSize="11sp"
                        android:fontFamily="@font/dm_sans"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Row 2: Cash Balance & Outstanding Debt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <!-- Cash Balance Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBalance"
                style="@style/Widget.StockManager.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CASH BALANCE"
                            android:textSize="10sp"
                            android:letterSpacing="0.08"
                            android:fontFamily="@font/dm_sans"
                            android:textColor="@color/text_secondary" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_wallet"
                            app:tint="@color/primary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/dm_sans"
                        android:textColor="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="In cash register"
                        android:textSize="11sp"
                        android:fontFamily="@font/dm_sans"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Outstanding Debt Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDebt"
                style="@style/Widget.StockManager.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="OUTSTANDING DEBT"
                            android:textSize="10sp"
                            android:letterSpacing="0.08"
                            android:fontFamily="@font/dm_sans"
                            android:textColor="@color/text_secondary" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_debt"
                            app:tint="@color/danger" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDebt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/dm_sans"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvDebtCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Unpaid by customers"
                        android:textSize="11sp"
                        android:fontFamily="@font/dm_sans"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Hidden backward-compatibility fields for legacy bindings -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone">
            <TextView android:id="@+id/tvProductCount" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvLowStock" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvExpenses" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ── 4. SALES PERFORMANCE CHART ────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StockManager.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Chart Title & Period Revenue -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sales Performance"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/dm_sans"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvChartPeriodRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/dm_sans"
                        android:textColor="@color/accent" />

                </LinearLayout>

                <!-- Time Filter Tabs: Today / This Week / This Month / This Year -->
                <LinearLayout
                    android:id="@+id/layoutChartTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tabToday"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:gravity="center"
                        android:text="Today"
                        android:textSize="12sp"
                        android:fontFamily="@font/dm_sans"
                        android:background="@drawable/bg_tab_unselected"
                        android:textColor="@color/text_secondary"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabWeek"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1.1"
                        android:layout_marginEnd="4dp"
                        android:gravity="center"
                        android:text="This Week"
                        android:textSize="12sp"
                        android:fontFamily="@font/dm_sans"
                        android:background="@drawable/bg_tab_selected"
                        android:textColor="@color/surface"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabMonth"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1.1"
                        android:layout_marginEnd="4dp"
                        android:gravity="center"
                        android:text="This Month"
                        android:textSize="12sp"
                        android:fontFamily="@font/dm_sans"
                        android:background="@drawable/bg_tab_unselected"
                        android:textColor="@color/text_secondary"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabYear"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="This Year"
                        android:textSize="12sp"
                        android:fontFamily="@font/dm_sans"
                        android:background="@drawable/bg_tab_unselected"
                        android:textColor="@color/text_secondary"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Custom Performance Chart -->
                <com.example.stockmaneger.ui.dashboard.SalesPerformanceChartView
                    android:id="@+id/salesChartView"
                    android:layout_width="match_parent"
                    android:layout_height="175dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── 5. RECENT SALES ────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recent Sales"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/dm_sans"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvViewAllSales"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="View all"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/dm_sans"
                android:textColor="@color/primary"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StockManager.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:id="@+id/llRecentSales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvNoSales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="28dp"
                android:gravity="center"
                android:text="No sales recorded yet"
                android:fontFamily="@font/dm_sans"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ── 6. LOW STOCK ALERTS ────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stock Alerts"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/dm_sans"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvViewAllStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="View all"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/dm_sans"
                android:textColor="@color/primary"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StockManager.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:id="@+id/llLowStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/tvNoLowStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/success" />

                <TextView
                    android:id="@+id/tvNoLowStockText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All stock levels look good"
                    android:fontFamily="@font/dm_sans"
                    android:textColor="@color/success"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── 7. RECENT EXPENSES ─────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recent Expenses"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/dm_sans"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvViewAllExpenses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="View all"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/dm_sans"
                android:textColor="@color/primary"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StockManager.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:id="@+id/layoutRecentExpenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
